{
  "name": "gladys-voltalis",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for the Voltalis box: heaters, water heater and other appliances (mode, preset, setpoint, energy index), power and energy of the home, programs, scene triggers and actions, dashboard widgets.",
  "homepage": "https://github.com/William-De71/gladys-voltalis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-voltalis.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "voltalis",
    "myvoltalis",
    "heater",
    "water-heater",
    "thermostat",
    "energy",
    "home-automation"
  ]
}
